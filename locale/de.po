msgid "Another package operation is in progress. Try again when it finishes."
msgstr ""
"Ein anderer Paketvorgang läuft bereits. Versuchen Sie es nach dessen "
"Abschluss erneut."

#: usr/share/comm-welcome/comm_welcome/installer.py:114
msgid "Checking available browsers…"
msgstr "Verfügbare Browser werden gesucht…"

#: usr/share/comm-welcome/comm_welcome/installer.py:116
msgid "Browser installation requires a compatible Pamac session service."
msgstr ""
"Für die Browserinstallation ist ein kompatibler Pamac-Sitzungsdienst "
"erforderlich."

#: usr/share/comm-welcome/comm_welcome/installer.py:132
msgid "Preparing installation…"
msgstr "Installation wird vorbereitet…"

#: usr/share/comm-welcome/comm_welcome/installer.py:143
#: usr/share/comm-welcome/comm_welcome/installer.py:207
msgid "The installation could not be completed."
msgstr "Die Installation konnte nicht abgeschlossen werden."

#: usr/share/comm-welcome/comm_welcome/installer.py:171
msgid "This installation needs additional review. Open Software to continue."
msgstr ""
"Diese Installation muss zusätzlich überprüft werden. Öffnen Sie Software, um"
" fortzufahren."

#: usr/share/comm-welcome/comm_welcome/installer.py:174
msgid "Complete any authentication requested by the system."
msgstr ""
"Schließen Sie eine gegebenenfalls vom System angeforderte Authentifizierung "
"ab."

#: usr/share/comm-welcome/comm_welcome/installer.py:188
#: usr/share/comm-welcome/comm_welcome/installer.py:190
#, python-brace-format
msgid "Installing {browser}…"
msgstr "{browser} wird installiert…"

#: usr/share/comm-welcome/comm_welcome/installer.py:200
msgid ""
"Additional review is required. Open Software after this operation finishes."
msgstr ""
"Eine zusätzliche Überprüfung ist erforderlich. Öffnen Sie Software, sobald "
"dieser Vorgang abgeschlossen ist."

#: usr/share/comm-welcome/comm_welcome/installer.py:205
#, python-brace-format
msgid "{browser} installed."
msgstr "{browser} wurde installiert."

