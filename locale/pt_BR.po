msgstr "Não foi possível alterar o navegador padrão."

#: usr/share/comm-welcome/comm_welcome/browser_page.py:221
#, python-brace-format
msgid "{browser} is now your default browser."
msgstr "{browser} agora é seu navegador padrão."

#: usr/share/comm-welcome/comm_welcome/browser_page.py:249
msgid "Available in the official repositories"
msgstr "Disponível nos repositórios oficiais"

#: usr/share/comm-welcome/comm_welcome/browser_page.py:251
msgid "Available in the AUR, built by Pamac on this computer"
msgstr "Disponível no AUR, compilado pelo Pamac neste computador"

#: usr/share/comm-welcome/comm_welcome/browser_page.py:253
msgid "Not in the official repositories; Software can search the AUR"
msgstr "Fora dos repositórios oficiais; a loja pode procurar no AUR"

#: usr/share/comm-welcome/comm_welcome/browser_page.py:255
#: usr/share/comm-welcome/comm_welcome/installer.py:147
msgid "Checking available browsers…"
msgstr "Verificando os navegadores disponíveis…"

#: usr/share/comm-welcome/comm_welcome/browser_page.py:257
#: usr/share/comm-welcome/comm_welcome/browser_page.py:258
msgid "Try again"
msgstr "Tentar novamente"

#: usr/share/comm-welcome/comm_welcome/catalog.py:21
msgid "Everyday"
msgstr "Dia a dia"

#: usr/share/comm-welcome/comm_welcome/catalog.py:21
msgid "Audio and video"
msgstr "Áudio e vídeo"

#: usr/share/comm-welcome/comm_welcome/catalog.py:21
msgid "System and family"
msgstr "Sistema e família"

#: usr/share/comm-welcome/comm_welcome/catalog.py:21
msgid "Development"
msgstr "Desenvolvimento"

#: usr/share/comm-welcome/comm_welcome/catalog.py:38
msgid "Generate passwords and organize them in an encrypted vault."
msgstr "Gere senhas e organize suas contas em um cofre criptografado."

#: usr/share/comm-welcome/comm_welcome/catalog.py:41
msgid "Create passwords and passphrases without leaving the desktop."
msgstr "Crie senhas e frases-senha sem sair do desktop."

#: usr/share/comm-welcome/comm_welcome/catalog.py:42
msgid "Keep accounts organized with categories, favorites, and search."
msgstr "Organize suas contas com categorias, favoritos e busca."

#: usr/share/comm-welcome/comm_welcome/catalog.py:43
msgid "Bring existing passwords with the import tools."
msgstr "Traga suas senhas existentes com as ferramentas de importação."

#: usr/share/comm-welcome/comm_welcome/catalog.py:47
msgid "Your passwords, encrypted."
msgstr "Suas senhas, criptografadas."

#: usr/share/comm-welcome/comm_welcome/catalog.py:52
msgid "View, convert, and resize images, individually or in batches."
msgstr "Visualize, converta e redimensione imagens, uma a uma ou em lote."

#: usr/share/comm-welcome/comm_welcome/catalog.py:55
msgid "Browse a folder of photos with zoom and a slideshow."
msgstr "Explore as fotos de uma pasta com zoom e apresentação de slides."

#: usr/share/comm-welcome/comm_welcome/catalog.py:56
msgid "Convert formats and resize several images in one operation."
msgstr "Converta formatos e redimensione várias imagens de uma só vez."

#: usr/share/comm-welcome/comm_welcome/catalog.py:57
msgid "Access image tools from your file manager."
msgstr "Acesse as ferramentas de imagem pelo gerenciador de arquivos."

#: usr/share/comm-welcome/comm_welcome/catalog.py:61
msgid "View and convert images."
msgstr "Veja e converta imagens."

#: usr/share/comm-welcome/comm_welcome/catalog.py:66
msgid "Find wallpapers and give your desktop a personal touch."
msgstr "Encontre papéis de parede e dê seu toque pessoal ao desktop."

#: usr/share/comm-welcome/comm_welcome/catalog.py:70
msgid "Preview system wallpapers and images from folders you choose."
msgstr "Veja os papéis de parede do sistema e as imagens das pastas que você escolher."

#: usr/share/comm-welcome/comm_welcome/catalog.py:71
msgid "Organize favorites and collections without duplicating your images."
msgstr "Organize favoritos e coleções sem duplicar suas imagens."

#: usr/share/comm-welcome/comm_welcome/catalog.py:72
msgid "Choose wallpapers for light and dark styles, or rotate them automatically."
msgstr "Escolha papéis de parede para os estilos claro e escuro ou ative a troca automática."

#: usr/share/comm-welcome/comm_welcome/catalog.py:75
msgid "Wallpapers to your taste."
msgstr "Papéis de parede a seu gosto."

#: usr/share/comm-welcome/comm_welcome/catalog.py:80
msgid "Use your favorite websites as apps."
msgstr "Use seus sites favoritos como aplicativos."

#: usr/share/comm-welcome/comm_welcome/catalog.py:83
msgid "Give a website its own window and application launcher."
msgstr "Dê a um site uma janela e um lançador próprios."

#: usr/share/comm-welcome/comm_welcome/catalog.py:84
msgid "Choose which installed browser opens each web app."
msgstr "Escolha qual navegador instalado abre cada aplicativo web."

#: usr/share/comm-welcome/comm_welcome/catalog.py:85
msgid "Organize your web apps with categories and search."
msgstr "Organize seus aplicativos web com categorias e busca."

#: usr/share/comm-welcome/comm_welcome/catalog.py:89
msgid "Favorite websites as apps."
msgstr "Sites favoritos como apps."

#: usr/share/comm-welcome/comm_welcome/catalog.py:94
msgid "Make scanned documents searchable and copyable."
msgstr "Torne o texto de documentos digitalizados pesquisável e copiável."

#: usr/share/comm-welcome/comm_welcome/catalog.py:97
msgid "Add searchable, copyable text to scanned PDFs and keep the original pages."
msgstr "Torne PDFs digitalizados pesquisáveis e copiáveis, mantendo as páginas originais."

#: usr/share/comm-welcome/comm_welcome/catalog.py:98
msgid "Export the recognized text as plain text, Markdown, or ODT."
msgstr "Exporte o texto reconhecido como texto simples, Markdown ou ODT."

#: usr/share/comm-welcome/comm_welcome/catalog.py:99
msgid "Reorder, rotate, merge, split, and compress pages in the PDF editor."
msgstr "Reordene, gire, junte, divida e comprima páginas no editor de PDF."

#: usr/share/comm-welcome/comm_welcome/catalog.py:103
msgid "Searchable text in scanned PDFs."
msgstr "Texto pesquisável em PDFs digitalizados."

#: usr/share/comm-welcome/comm_welcome/catalog.py:108
msgid "Extract editable text from images and screenshots."
msgstr "Extraia texto editável de imagens e capturas de tela."

#: usr/share/comm-welcome/comm_welcome/catalog.py:111
msgid "Open an image, drop it on the window, or paste it from the clipboard."
msgstr "Abra uma imagem, arraste-a para a janela ou cole-a da área de transferência."

#: usr/share/comm-welcome/comm_welcome/catalog.py:112
msgid "Capture a region of the screen and read the text in it."
msgstr "Capture uma área da tela e extraia o texto dela."

#: usr/share/comm-welcome/comm_welcome/catalog.py:113
msgid "Edit the recognized text and copy it to the clipboard."
msgstr "Edite o texto reconhecido e copie-o para a área de transferência."

#: usr/share/comm-welcome/comm_welcome/catalog.py:117
msgid "Copy the text from any image."
msgstr "Copie o texto de qualquer imagem."

#: usr/share/comm-welcome/comm_welcome/catalog.py:121
msgid "Text to speech"
msgstr "Narrador de texto"

#: usr/share/comm-welcome/comm_welcome/catalog.py:122
msgid "Hear any selected text read aloud."
msgstr "Ouça em voz alta qualquer texto selecionado."

#: usr/share/comm-welcome/comm_welcome/catalog.py:125
msgid "Select text anywhere and press Alt+V to hear it."
msgstr "Selecione um texto em qualquer lugar e tecle Alt+V para ouvi-lo."

#: usr/share/comm-welcome/comm_welcome/catalog.py:126
msgid "Choose a voice and adjust its speed and pitch."
msgstr "Escolha uma voz e ajuste a velocidade e o tom."

#: usr/share/comm-welcome/comm_welcome/catalog.py:127
msgid "Save readings as audio files and find them in the history."
msgstr "Salve as leituras em arquivos de áudio e encontre-as no histórico."

#: usr/share/comm-welcome/comm_welcome/catalog.py:131
msgid "Listen instead of reading."
msgstr "Ouça em vez de ler."

#: usr/share/comm-welcome/comm_welcome/catalog.py:136
msgid "Use a terminal that saves and organizes your local and SSH sessions."
msgstr "Use um terminal que salva e organiza suas sessões locais e SSH."

#: usr/share/comm-welcome/comm_welcome/catalog.py:139
msgid "Save local and SSH sessions and organize them in folders."
msgstr "Salve sessões locais e SSH e organize-as em pastas."

#: usr/share/comm-welcome/comm_welcome/catalog.py:140
msgid "Split the window into panes and group tabs by color."
msgstr "Divida a janela em painéis e agrupe as abas por cor."

#: usr/share/comm-welcome/comm_welcome/catalog.py:141
msgid "See command output colored automatically, without changing your shell."
msgstr "Veja a saída dos comandos colorida automaticamente, sem mexer no shell."

#: usr/share/comm-welcome/comm_welcome/catalog.py:145
msgid "Your terminal sessions, organized."
msgstr "Suas sessões de terminal, organizadas."

#: usr/share/comm-welcome/comm_welcome/catalog.py:151
msgid "Play a falling-block puzzle themed on Linux distributions."
msgstr "Jogue um quebra-cabeça de blocos com o tema das distribuições Linux."

#: usr/share/comm-welcome/comm_welcome/catalog.py:154
msgid "Stack pieces themed after seven Linux distributions."
msgstr "Encaixe peças inspiradas em sete distribuições Linux."

#: usr/share/comm-welcome/comm_welcome/catalog.py:155
msgid "Clear lines to charge the BigLinux power, then release it with Space."
msgstr "Complete linhas para carregar o poder BigLinux e use-o com a tecla Espaço."

#: usr/share/comm-welcome/comm_welcome/catalog.py:156
msgid "Hold a piece for later and chase your top five scores."
msgstr "Guarde uma peça para depois e tente entrar nas cinco melhores pontuações."

#: usr/share/comm-welcome/comm_welcome/catalog.py:160
msgid "A block puzzle with Linux pieces."
msgstr "Um jogo de blocos com peças do Linux."

#: usr/share/comm-welcome/comm_welcome/catalog.py:166
msgid "Annotate and record from GNOME's own screenshot tool."
msgstr "Anote e grave a tela pela própria ferramenta de captura do GNOME."

#: usr/share/comm-welcome/comm_welcome/catalog.py:169
msgid "Capture an area, a window, or the entire screen."
msgstr "Capture uma área, uma janela ou a tela inteira."

#: usr/share/comm-welcome/comm_welcome/catalog.py:170
msgid "Add arrows, text, and highlights to explain what is on screen."
msgstr "Use setas, textos e marcações para explicar o que aparece na tela."

#: usr/share/comm-welcome/comm_welcome/catalog.py:171
msgid "Record the screen with microphone or desktop audio."
msgstr "Grave a tela com áudio do microfone ou do computador."

#: usr/share/comm-welcome/comm_welcome/catalog.py:175
msgid "Capture, annotate, and record."
msgstr "Capture, anote e grave a tela."

#: usr/share/comm-welcome/comm_welcome/catalog.py:179
msgid "Noise filter"
msgstr "Redutor de ruídos"

#: usr/share/comm-welcome/comm_welcome/catalog.py:180
msgid "Reduce noise from your microphone and audio."
msgstr "Reduza ruídos do microfone e do áudio."

#: usr/share/comm-welcome/comm_welcome/catalog.py:183
msgid "Reduce background noise from your microphone during calls and recordings."
msgstr "Reduza o ruído de fundo do microfone em chamadas e gravações."

#: usr/share/comm-welcome/comm_welcome/catalog.py:184
msgid "Filter playback audio as well as microphone input."
msgstr "Filtre também o áudio reproduzido pelo computador."

#: usr/share/comm-welcome/comm_welcome/catalog.py:185
msgid "Adjust the filters in a dedicated desktop app."
msgstr "Ajuste os filtros em um aplicativo próprio do desktop."

#: usr/share/comm-welcome/comm_welcome/catalog.py:189
msgid "Less noise in your calls."
msgstr "Menos ruído nas chamadas."

#: usr/share/comm-welcome/comm_welcome/catalog.py:194
msgid "Enhance the sound of every app with ready-made profiles."
msgstr "Melhore o som de todos os aplicativos com perfis prontos."

#: usr/share/comm-welcome/comm_welcome/catalog.py:197
msgid "Choose a profile for music, games, movies, or dialogue."
msgstr "Escolha um perfil para música, jogos, filmes ou diálogos."

#: usr/share/comm-welcome/comm_welcome/catalog.py:198
msgid "Adjust bass, treble clarity, stereo width, and compression."
msgstr "Ajuste graves, clareza dos agudos, largura estéreo e compressão."

#: usr/share/comm-welcome/comm_welcome/catalog.py:199
msgid "Keep processing on when you switch speakers or connect Bluetooth."
msgstr "Mantenha o processamento ao trocar de saída ou conectar um Bluetooth."

#: usr/share/comm-welcome/comm_welcome/catalog.py:203
msgid "Sound profiles for the whole system."
msgstr "Perfis de som para todo o sistema."

#: usr/share/comm-welcome/comm_welcome/catalog.py:207
msgid "Audio converter"
msgstr "Conversor de áudio"

#: usr/share/comm-welcome/comm_welcome/catalog.py:208
msgid "Convert audio, cut segments, and remove pauses from speech."
msgstr "Converta áudio, corte trechos e remova pausas da fala."

#: usr/share/comm-welcome/comm_welcome/catalog.py:211
msgid "Convert to MP3, FLAC, Opus, and more, or extract the audio from a video."
msgstr "Converta para MP3, FLAC, Opus e outros formatos, ou extraia o áudio de um vídeo."

#: usr/share/comm-welcome/comm_welcome/catalog.py:212
msgid "Mark the parts to keep or remove directly on the waveform."
msgstr "Marque os trechos a manter ou remover direto na forma de onda."

#: usr/share/comm-welcome/comm_welcome/catalog.py:213
msgid "Remove pauses from speech and reduce background noise."
msgstr "Remova pausas da fala e reduza o ruído de fundo."

#: usr/share/comm-welcome/comm_welcome/catalog.py:217
msgid "Convert and trim your audio."
msgstr "Converta e corte seus áudios."

#: usr/share/comm-welcome/comm_welcome/catalog.py:221
msgid "Video converter"
msgstr "Conversor de vídeo"

#: usr/share/comm-welcome/comm_welcome/catalog.py:222
msgid "Convert, trim, and optimize your videos."
msgstr "Converta, corte e otimize seus vídeos."

#: usr/share/comm-welcome/comm_welcome/catalog.py:225
msgid "Convert a whole queue of videos to MP4, MKV, MOV, or WebM."
msgstr "Converta uma fila inteira de vídeos para MP4, MKV, MOV ou WebM."

#: usr/share/comm-welcome/comm_welcome/catalog.py:226
msgid "Trim, crop, and rotate a video, with a preview before exporting."
msgstr "Corte trechos, recorte e gire um vídeo, com prévia antes de exportar."

#: usr/share/comm-welcome/comm_welcome/catalog.py:227
msgid "Fit a video under a target size or split it into parts."
msgstr "Ajuste um vídeo a um tamanho máximo ou divida-o em partes."

#: usr/share/comm-welcome/comm_welcome/catalog.py:231
msgid "Convert and trim your videos."
msgstr "Converta e corte seus vídeos."

#: usr/share/comm-welcome/comm_welcome/catalog.py:236
msgid "Record and edit voice notes on your computer."
msgstr "Grave e edite notas de voz no seu computador."

#: usr/share/comm-welcome/comm_welcome/catalog.py:239
msgid "Record from the microphone and pause or resume at any time."
msgstr "Grave pelo microfone e pause ou retome quando quiser."

#: usr/share/comm-welcome/comm_welcome/catalog.py:240
msgid "Trim, merge, or change the speed and pitch of a recording."
msgstr "Corte, junte ou altere a velocidade e o tom de uma gravação."

#: usr/share/comm-welcome/comm_welcome/catalog.py:241
msgid "Export recordings as WAV, MP3, Opus, or FLAC."
msgstr "Exporte gravações em WAV, MP3, Opus ou FLAC."

#: usr/share/comm-welcome/comm_welcome/catalog.py:245
msgid "Voice notes, recorded locally."
msgstr "Notas de voz gravadas no seu computador."

#: usr/share/comm-welcome/comm_welcome/catalog.py:250
msgid "Use a phone, USB camera, or DSLR as a webcam."
msgstr "Use o celular, uma câmera USB ou DSLR como webcam."

#: usr/share/comm-welcome/comm_welcome/catalog.py:253
msgid "Connect a phone through the browser, Wi-Fi, USB, or AirPlay."
msgstr "Conecte o celular pelo navegador, Wi-Fi, USB ou AirPlay."

#: usr/share/comm-welcome/comm_welcome/catalog.py:254
msgid "Send the image to video calls through a virtual camera."
msgstr "Leve a imagem para chamadas de vídeo por uma câmera virtual."

#: usr/share/comm-welcome/comm_welcome/catalog.py:255
msgid "Apply real-time effects, take photos, and record videos."
msgstr "Aplique efeitos em tempo real, tire fotos e grave vídeos."

#: usr/share/comm-welcome/comm_welcome/catalog.py:259
msgid "Any camera as your webcam."
msgstr "Qualquer câmera como webcam."

#: usr/share/comm-welcome/comm_welcome/catalog.py:265
msgid "Choose your desktop layout, theme, panels, and effects."
msgstr "Escolha o layout, o tema, os painéis e os efeitos do desktop."

#: usr/share/comm-welcome/comm_welcome/catalog.py:269
msgid "Switch the desktop layout and undo the change if needed."
msgstr "Troque o layout do desktop e desfaça a mudança se precisar."

#: usr/share/comm-welcome/comm_welcome/catalog.py:270
msgid "Choose fonts, accent colors, and icon themes."
msgstr "Escolha fontes, cores de destaque e temas de ícones."

#: usr/share/comm-welcome/comm_welcome/catalog.py:271
msgid "Find and install GNOME extensions without opening a browser."
msgstr "Encontre e instale extensões do GNOME sem abrir o navegador."

#: usr/share/comm-welcome/comm_welcome/catalog.py:275
msgid "Your GNOME, your layout."
msgstr "Seu GNOME, do seu jeito."

#: usr/share/comm-welcome/comm_welcome/catalog.py:280
msgid "Share your screen with a TV, projector or Chromecast."
msgstr "Compartilhe sua tela com uma TV, projetor ou Chromecast."

#: usr/share/comm-welcome/comm_welcome/catalog.py:285
msgid "General settings"
msgstr "Ajustes gerais"

#: usr/share/comm-welcome/comm_welcome/catalog.py:286
msgid "Adjust power, performance, devices, and services in one place."
msgstr "Ajuste energia, desempenho, dispositivos e serviços em um só lugar."

#: usr/share/comm-welcome/comm_welcome/catalog.py:289
