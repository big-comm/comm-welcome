#: usr/share/comm-welcome/comm_welcome/browser_page.py:168
#: usr/share/comm-welcome/comm_welcome/browser_page.py:258
msgid "Install from the AUR"
msgstr "Instalar do AUR"

#: usr/share/comm-welcome/comm_welcome/browser_page.py:171
#, python-brace-format
msgid "Install {app} from the AUR"
msgstr "Instalar o {app} do AUR"

#: usr/share/comm-welcome/comm_welcome/browser_page.py:174
msgid "Find in Software"
msgstr "Procurar na loja"

#: usr/share/comm-welcome/comm_welcome/browser_page.py:182
#, python-brace-format
msgid "Install {app} from the AUR?"
msgstr "Instalar o {app} do AUR?"

#: usr/share/comm-welcome/comm_welcome/browser_page.py:184
#, python-brace-format
msgid "{app} is not in the official repositories. Pamac will download the build recipe from the AUR, maintained by the Arch community rather than by BigCommunity, and build the package on this computer. Pamac shows the recipe and asks for your password before installing."
msgstr "O {app} não está nos repositórios oficiais. O Pamac vai baixar a receita de compilação do AUR, mantido pela comunidade do Arch e não pelo BigCommunity, e montar o pacote neste computador. O Pamac mostra a receita e pede sua senha antes de instalar."

#: usr/share/comm-welcome/comm_welcome/browser_page.py:191
msgid "Cancel"
msgstr "Cancelar"

#: usr/share/comm-welcome/comm_welcome/browser_page.py:192
msgid "Continue in Pamac"
msgstr "Continuar no Pamac"

#: usr/share/comm-welcome/comm_welcome/browser_page.py:212
