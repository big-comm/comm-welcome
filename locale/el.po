msgid "Convert your videos to other formats."
msgstr "Μετατρέψτε τα βίντεό σας σε άλλες μορφές."

#: usr/share/comm-welcome/comm_welcome/catalog.py:59
msgid "Record and organize voice notes."
msgstr "Ηχογραφήστε και οργανώστε φωνητικές σημειώσεις."

#: usr/share/comm-welcome/comm_welcome/catalog.py:64
msgid "General settings"
msgstr "Γενικές ρυθμίσεις"

#: usr/share/comm-welcome/comm_welcome/catalog.py:65
msgid "Explore your system settings."
msgstr "Εξερευνήστε τις ρυθμίσεις του συστήματός σας."

#: usr/share/comm-welcome/comm_welcome/catalog.py:70
msgid "Hardware information"
msgstr "Πληροφορίες υλικού"

#: usr/share/comm-welcome/comm_welcome/catalog.py:71
msgid "Get to know your computer's components."
msgstr "Γνωρίστε τα εξαρτήματα του υπολογιστή σας."

#: usr/share/comm-welcome/comm_welcome/catalog.py:76
msgid "Hardware management"
msgstr "Διαχείριση υλικού"

#: usr/share/comm-welcome/comm_welcome/catalog.py:77
msgid "Access driver and kernel options."
msgstr "Αποκτήστε πρόσβαση στις επιλογές προγραμμάτων οδήγησης και πυρήνα."

#: usr/share/comm-welcome/comm_welcome/catalog.py:82
msgid "Parental controls"
msgstr "Γονικοί έλεγχοι"

#: usr/share/comm-welcome/comm_welcome/catalog.py:83
msgid "Explore controls for computer use."
msgstr "Εξερευνήστε τους ελέγχους χρήσης του υπολογιστή."

#: usr/share/comm-welcome/comm_welcome/catalog.py:88
msgid "Network information"
msgstr "Πληροφορίες δικτύου"

#: usr/share/comm-welcome/comm_welcome/catalog.py:89
msgid "View details about your network connections."
msgstr "Δείτε λεπτομέρειες για τις συνδέσεις δικτύου σας."

#: usr/share/comm-welcome/comm_welcome/donations.py:17
msgid "Support BigCommunity"
msgstr "Υποστηρίξτε το BigCommunity"

#: usr/share/comm-welcome/comm_welcome/donations.py:24
msgid "Your support makes a difference"
msgstr "Η υποστήριξή σας κάνει τη διαφορά"

#: usr/share/comm-welcome/comm_welcome/donations.py:25
msgid ""
"Help maintain our servers, develop new features, and support the community."
msgstr ""
"Βοηθήστε στη συντήρηση των διακομιστών μας, στην ανάπτυξη νέων λειτουργιών "
"και στην υποστήριξη της κοινότητας."

#: usr/share/comm-welcome/comm_welcome/donations.py:28
msgid "Choose how you would like to contribute."
msgstr "Επιλέξτε πώς θέλετε να συνεισφέρετε."

#: usr/share/comm-welcome/comm_welcome/donations.py:32
msgid "PIX — email key"
msgstr "PIX — κλειδί email"

#: usr/share/comm-welcome/comm_welcome/donations.py:32
msgid "Copy PIX key"
msgstr "Αντιγραφή κλειδιού PIX"

#: usr/share/comm-welcome/comm_welcome/donations.py:32
msgid "PIX key copied"
msgstr "Το κλειδί PIX αντιγράφηκε"

#: usr/share/comm-welcome/comm_welcome/donations.py:38
msgid "Paste this key into your banking app and choose the amount."
msgstr ""
"Επικολλήστε αυτό το κλειδί στην τραπεζική εφαρμογή σας και επιλέξτε το ποσό."

#: usr/share/comm-welcome/comm_welcome/donations.py:40
msgid "Cryptocurrency"
msgstr "Κρυπτονόμισμα"

#: usr/share/comm-welcome/comm_welcome/donations.py:44
msgid "USDT — TRC20 network"
msgstr "USDT — δίκτυο TRC20"

#: usr/share/comm-welcome/comm_welcome/donations.py:46
msgid "Copy USDT address"
msgstr "Αντιγραφή διεύθυνσης USDT"

#: usr/share/comm-welcome/comm_welcome/donations.py:47
msgid "USDT address copied"
msgstr "Η διεύθυνση USDT αντιγράφηκε"

#: usr/share/comm-welcome/comm_welcome/donations.py:51
msgid "Bitcoin — BTC network"
msgstr "Bitcoin — δίκτυο BTC"

#: usr/share/comm-welcome/comm_welcome/donations.py:53
msgid "Copy Bitcoin address"
msgstr "Αντιγραφή διεύθυνσης Bitcoin"

#: usr/share/comm-welcome/comm_welcome/donations.py:54
msgid "Bitcoin address copied"
msgstr "Η διεύθυνση Bitcoin αντιγράφηκε"

#: usr/share/comm-welcome/comm_welcome/donations.py:60
msgid "Other ways to give"
msgstr "Άλλοι τρόποι προσφοράς"

#: usr/share/comm-welcome/comm_welcome/donations.py:63
msgid "Telegram donation bot"
msgstr "Bot δωρεών Telegram"

#: usr/share/comm-welcome/comm_welcome/donations.py:64
msgid "Continue in Telegram."
msgstr "Συνέχεια στο Telegram."

#: usr/share/comm-welcome/comm_welcome/donations.py:70
msgid "Patreon"
msgstr "Patreon"

#: usr/share/comm-welcome/comm_welcome/donations.py:71
msgid "Monthly support. Continue on Patreon in your browser."
msgstr ""
"Μηνιαία υποστήριξη. Συνεχίστε στο Patreon από το πρόγραμμα περιήγησής σας."

#: usr/share/comm-welcome/comm_welcome/installer.py:102
msgid "The installer connection was lost. Check Software before retrying."
msgstr ""
"Η σύνδεση με το πρόγραμμα εγκατάστασης χάθηκε. Ελέγξτε το Λογισμικό πριν "
"δοκιμάσετε ξανά."

#: usr/share/comm-welcome/comm_welcome/installer.py:108
msgid "Another installation is in progress."
msgstr "Μια άλλη εγκατάσταση βρίσκεται σε εξέλιξη."

#: usr/share/comm-welcome/comm_welcome/installer.py:110
msgid "Connect to the internet to install another browser."
msgstr ""
"Συνδεθείτε στο διαδίκτυο για να εγκαταστήσετε άλλο πρόγραμμα περιήγησης."

#: usr/share/comm-welcome/comm_welcome/installer.py:112
msgid "Another package operation is in progress. Try again when it finishes."
msgstr ""
"Μια άλλη λειτουργία πακέτου βρίσκεται σε εξέλιξη. Δοκιμάστε ξανά όταν "
"ολοκληρωθεί."

#: usr/share/comm-welcome/comm_welcome/installer.py:114
msgid "Checking available browsers…"
msgstr "Έλεγχος διαθέσιμων προγραμμάτων περιήγησης…"

#: usr/share/comm-welcome/comm_welcome/installer.py:116
msgid "Browser installation requires a compatible Pamac session service."
msgstr ""
"Η εγκατάσταση προγράμματος περιήγησης απαιτεί συμβατή υπηρεσία συνεδρίας "
"Pamac."

#: usr/share/comm-welcome/comm_welcome/installer.py:132
msgid "Preparing installation…"
msgstr "Προετοιμασία εγκατάστασης…"

#: usr/share/comm-welcome/comm_welcome/installer.py:143
#: usr/share/comm-welcome/comm_welcome/installer.py:207
msgid "The installation could not be completed."
msgstr "Δεν ήταν δυνατή η ολοκλήρωση της εγκατάστασης."

#: usr/share/comm-welcome/comm_welcome/installer.py:171
msgid "This installation needs additional review. Open Software to continue."
msgstr ""
"Αυτή η εγκατάσταση χρειάζεται πρόσθετο έλεγχο. Ανοίξτε το Λογισμικό για να "
"συνεχίσετε."

#: usr/share/comm-welcome/comm_welcome/installer.py:174
msgid "Complete any authentication requested by the system."
msgstr "Ολοκληρώστε τυχόν έλεγχο ταυτότητας που ζητά το σύστημα."

#: usr/share/comm-welcome/comm_welcome/installer.py:188
#: usr/share/comm-welcome/comm_welcome/installer.py:190
#, python-brace-format
msgid "Installing {browser}…"
msgstr "Εγκατάσταση του {browser}…"

#: usr/share/comm-welcome/comm_welcome/installer.py:200
msgid ""
"Additional review is required. Open Software after this operation finishes."
msgstr ""
"Απαιτείται πρόσθετος έλεγχος. Ανοίξτε το Λογισμικό αφού ολοκληρωθεί αυτή η "
"λειτουργία."

#: usr/share/comm-welcome/comm_welcome/installer.py:205
#, python-brace-format
msgid "{browser} installed."
msgstr "Το {browser} εγκαταστάθηκε."

