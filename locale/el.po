msgid "Reduce noise from your microphone and audio."
msgstr "Μειώστε τον θόρυβο από το μικρόφωνο και τον ήχο σας."

#: usr/share/comm-welcome/comm_welcome/catalog.py:46
msgid "Audio converter"
msgstr "Μετατροπέας ήχου"

#: usr/share/comm-welcome/comm_welcome/catalog.py:47
msgid "Convert audio files to other formats."
msgstr "Μετατρέψτε αρχεία ήχου σε άλλες μορφές."

#: usr/share/comm-welcome/comm_welcome/catalog.py:52
msgid "Video converter"
