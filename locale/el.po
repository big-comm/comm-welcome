#: usr/share/comm-welcome/comm_welcome/browser_page.py:17
msgid "Which browser suits you?"
msgstr "Ποιο πρόγραμμα περιήγησης σας ταιριάζει;"

#: usr/share/comm-welcome/comm_welcome/browser_page.py:18
msgid "Keep your current browser or choose another one to install."
msgstr ""
"Κρατήστε το τρέχον πρόγραμμα περιήγησης ή επιλέξτε κάποιο άλλο για "
"εγκατάσταση."

