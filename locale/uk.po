msgid "Copy USDT address"
msgstr "Копіювати адресу USDT"

#: usr/share/comm-welcome/comm_welcome/donations.py:47
msgid "USDT address copied"
msgstr "Адресу USDT скопійовано"

#: usr/share/comm-welcome/comm_welcome/donations.py:51
msgid "Bitcoin — BTC network"
msgstr "Bitcoin — мережа BTC"

#: usr/share/comm-welcome/comm_welcome/donations.py:53
msgid "Copy Bitcoin address"
msgstr "Копіювати адресу Bitcoin"

#: usr/share/comm-welcome/comm_welcome/donations.py:54
msgid "Bitcoin address copied"
msgstr "Адресу Bitcoin скопійовано"

#: usr/share/comm-welcome/comm_welcome/donations.py:60
msgid "Other ways to give"
msgstr "Інші способи зробити внесок"

#: usr/share/comm-welcome/comm_welcome/donations.py:63
msgid "Telegram donation bot"
msgstr "Бот для пожертв у Telegram"

#: usr/share/comm-welcome/comm_welcome/donations.py:64
msgid "Continue in Telegram."
msgstr "Продовжити в Telegram."

