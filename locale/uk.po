msgid "Choose how you would like to contribute."
msgstr "Виберіть, як саме ви хочете допомогти."

#: usr/share/comm-welcome/comm_welcome/donations.py:32
msgid "PIX — email key"
msgstr "PIX — ключ електронною поштою"

